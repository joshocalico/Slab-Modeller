[configuration]

entry_symbol = "slab_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

macos.debug = "res://addons/slab/bin/libslab.macos.template_debug.framework"
macos.release = "res://addons/slab/bin/libslab.macos.template_release.framework"
windows.debug.x86_64 = "res://addons/slab/bin/libslab.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/slab/bin/libslab.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/slab/bin/libslab.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/slab/bin/libslab.linux.template_release.x86_64.so"
