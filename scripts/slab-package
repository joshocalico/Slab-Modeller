#!/usr/bin/env python3
"""Package tracked Slab addon files and six staged desktop libraries for installation."""

import argparse
import configparser
from pathlib import Path, PurePosixPath
import subprocess
import tempfile
import zipfile


FEATURES = {
    "macos.debug", "macos.release",
    "windows.debug.x86_64", "windows.release.x86_64",
    "linux.debug.x86_64", "linux.release.x86_64",
}
PREFIX = "res://addons/slab/bin/"


def required_binaries(manifest):
    config = configparser.ConfigParser()
    config.read(manifest, encoding="utf-8")
    libraries = config["libraries"]
    if set(libraries) != FEATURES:
        raise ValueError("Update the release platform matrix: unexpected .gdextension library keys")
    paths = set()
    for value in libraries.values():
        resource = value.strip('"')
        if not resource.startswith(PREFIX):
            raise ValueError(f"Library is outside addon bin directory: {resource}")
        relative = PurePosixPath(resource[len(PREFIX):])
        if relative.is_absolute() or ".." in relative.parts:
            raise ValueError(f"Unsafe library path: {resource}")
        if relative.suffix == ".framework":
            relative /= relative.stem
        paths.add(relative.as_posix())
    if len(paths) != 6:
        raise ValueError("Expected six distinct library files")
    return paths


def package(root, binaries, output):
    addon = root / "project/addons/slab"
    required = required_binaries(addon / "slab.gdextension")
    if not binaries.is_dir():
        raise ValueError(f"Binary directory does not exist: {binaries}")
    staged = set()
    for path in binaries.rglob("*"):
        if path.is_symlink():
            raise ValueError(f"Symlinks are not release artifacts: {path}")
        if path.is_file():
            staged.add(path.relative_to(binaries).as_posix())
        elif not path.is_dir():
            raise ValueError(f"Not a regular file: {path}")
    missing = required - staged
    extra = staged - required
    if missing:
        raise ValueError("Missing libraries: " + ", ".join(sorted(missing)))
    if extra:
        raise ValueError("Unexpected artifacts: " + ", ".join(sorted(extra)))
    for name in required:
        if (binaries / name).stat().st_size == 0:
            raise ValueError(f"Empty library: {name}")

    tracked = subprocess.check_output(
        ["git", "ls-files", "-z", "--", "project/addons/slab"], cwd=root
    ).decode("utf-8").split("\0")
    entries = {}
    for name in filter(None, tracked):
        path = root / name
        relative = path.relative_to(addon)
        if relative.parts[0] == "bin":
            continue
        if path.is_symlink() or not path.is_file():
            raise ValueError(f"Tracked addon file is missing or not a regular file: {name}")
        entries["addons/slab/" + relative.as_posix()] = path
    for essential in ("plugin.cfg", "slab.gdextension"):
        if "addons/slab/" + essential not in entries:
            raise ValueError(f"Missing tracked addon entry point: {essential}")
    entries["addons/slab/LICENSE"] = root / "LICENSE"
    entries.update({"addons/slab/bin/" + name: binaries / name for name in required})

    output.parent.mkdir(parents=True, exist_ok=True)
    # Fixed timestamps, ordering, permissions, and compression make repeat builds identical.
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=output.parent, suffix=".zip", delete=False) as file:
            temporary = Path(file.name)
        with zipfile.ZipFile(temporary, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
            for name, path in sorted(entries.items()):
                info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
                info.create_system = 3
                info.external_attr = (0o100755 if name.startswith("addons/slab/bin/") else 0o100644) << 16
                info.compress_type = zipfile.ZIP_DEFLATED
                archive.writestr(info, path.read_bytes(), compresslevel=9)
        temporary.replace(output)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    print(f"Packaged {len(entries)} files, including all six desktop libraries: {output}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binaries", required=True, type=Path,
                        help="Staged bin directory containing only the six built libraries")
    parser.add_argument("--output", required=True, type=Path, help="Destination addon ZIP")
    args = parser.parse_args()
    try:
        package(Path(__file__).resolve().parent.parent, args.binaries.resolve(), args.output.resolve())
    except (ValueError, OSError, KeyError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"slab-package: {error}\n")


if __name__ == "__main__":
    main()
